{
  "name": "@nkzw/joymap",
  "version": "5.0.0",
  "description": "A modern Gamepad API wrapper and input mapping library.",
  "keywords": [
    "gamepad",
    "joystick"
  ],
  "homepage": "https://github.com/nkzw-tech/joymap",
  "license": "MIT",
  "author": {
    "name": "Diego Doumecq & Christoph Nakazawa",
    "email": "licenciado.diego@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkzw-tech/joymap"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "demo": "vp dev demo",
    "demo:build": "vp build demo",
    "format": "vp fmt --write .",
    "lint": "vp lint .",
    "prepare": "vp config",
    "test": "vp test"
  },
  "devDependencies": {
    "@nkzw/eslint-plugin": "^2.0.0",
    "@nkzw/oxlint-config": "^2.0.1",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  }
}
